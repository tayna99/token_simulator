# Server-side key is preferred. If omitted, /api/agent can still use payload.apiKey.
OPENAI_API_KEY=sk-...

# Default model for interpretation-only structured output.
AGENT_MODEL=gpt-5-mini

# Optional one-off live smoke. Keep disabled in normal test runs and CI.
AGENT_LIVE_TESTS=0
AGENT_SMOKE_API_KEY=
